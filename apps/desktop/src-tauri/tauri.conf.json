{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanProjects",
  "version": "2.2.0",
  "identifier": "com.furkanmeclis.cleanprojects",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CleanProjects",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Developer disk cleanup",
    "longDescription": "Scan package caches, build artifacts, IDE and browser caches, Docker and git worktrees, then clean only what you select.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxRDhFMjAzOTNBODlFQTMKUldTam5xaVRBK0xZa1hDZFhHc1czMEZwWC9PdXhpZkVZN3RlVFNTL0lVdmxmNEdLaHVSdG5QY1YK",
      "endpoints": [
        "https://github.com/furkanmeclis/clean-projects/releases/latest/download/latest.json"
      ]
    }
  }
}
